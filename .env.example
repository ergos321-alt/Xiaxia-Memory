DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require
MEMORY_API_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=replace-with-a-different-password
FLASK_SECRET_KEY=replace-with-random-secret
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
MEM0_TELEMETRY=false
MEM0_COLLECTION=xiaxia_mem0_memories
MEM0_USER_ID=xiaxia_shared_life
MEM0_HISTORY_DB_PATH=/tmp/xiaxia_mem0_history.db
DB_POOL_MIN=1
DB_POOL_MAX=1
MEM0_DB_POOL_MIN=1
MEM0_DB_POOL_MAX=2
MAX_RAW_TEXT_CHARS=24000
